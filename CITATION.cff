    affiliation: "Swiss Federal Institute for Forest, Snow and Landscape Research WSL, Birmensdorf, Switzerland"
repository-code: "https://github.com/nnamremmizxilef/2026_Soilscape_Genomics"
license: CC0-1.0
version: 0.1.0
date-released: "2026-09-18"
keywords:
  - soil properties
  - SoilGrids
  - WoSIS
  - SoilTemp
  - soil temperature
  - soil organic carbon
  - soil pH


